{
  "title": "Static Evolution public data",
  "description": "A read-only public mirror of published content from staticevolution.com",
  "databases": {
    "staticevolution": {
      "source": "Static Evolution",
      "source_url": "https://staticevolution.com/"
    }
  },
  "plugins": {
    "datasette-auth-passwords": {
      "root_password_hash": {
        "$env": "DATASETTE_ADMIN_PASSWORD_HASH"
      }
    }
  }
}
